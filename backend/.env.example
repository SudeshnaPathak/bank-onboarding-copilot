# Copy to backend/.env. Everything has a working default for local demo.
ENV=dev
JWT_SECRET=change-me
FERNET_KEY=            # required when ENV != dev:  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_PROVIDER=auto        # auto | gemini | rules   (auto = Gemini when GOOGLE_API_KEY is set, else the rule-based service)
AIPG_API_KEY=
GEMINI_MODEL=gemini-2.5-flash   # verify against the models available to your account
OCR_ENGINE=paddle        # auto | paddle | fixture
DEMO_MODE=true
# DATABASE_URL=postgresql+asyncpg://onboarding:dev@localhost:5432/onboarding
# CHECKPOINT_URL=postgresql://onboarding:dev@localhost:5432/onboarding
MAX_PDF_PAGES=5          # PDFs longer than this are refused
PDF_RENDER_DPI=200       # resolution used to rasterise scanned PDFs for OCR
